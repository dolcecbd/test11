      padding: 15px 4px;
      text-align: center;
      font-size: 12px;
      font-weight: 800;
      color: #1e293b;
      cursor: pointer;
    }
    .channel-item.active { border: 1.5px solid #e11d48 !important; color: #e11d48 !important; }
    .points-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px 6px; margin-top: 10px; }
    .point-item {
      background: #ffffff;
      border: 1.2px solid #e2e8f0;
      border-radius: 6px;
      padding: 10px 2px;
      text-align: center;
      font-size: 11px;
      font-weight: 700;
      color: #334155;
      cursor: pointer;
      position: relative;
    }
    .point-item.active { border-color: #e11d48; color: #e11d48; }
    .point-bonus-tag {
      position: absolute;
      top: -8px;
      left: 50%;
