    .pay-qr-card { background: #ffffff; margin-top: 10px; padding: 16px; }
    .qr-split-layout { display: flex; gap: 16px; }
    .qr-left-col { width: 40%; display: flex; flex-direction: column; align-items: center; gap: 10px; }
    .qr-box { width: 100%; aspect-ratio: 1/1; border: 1px solid #e2e8f0; border-radius: 8px; padding: 4px; }
    .qr-right-col { flex: 1; display: flex; flex-direction: column; gap: 14px; }
    .copy-group { display: flex; flex-direction: column; gap: 4px; }
    .copy-text-val { color: #d97706; font-weight: 700; font-size: 14px; }

    /* TOAST */
    .toast-container {
      position: fixed;
      top: 30px;
      left: 50%;
      transform: translateX(-50%) translateY(-20px);
      background: rgba(0, 0, 0, 0.85);
      color: #ffffff;
      padding: 10px 20px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      z-index: 100005;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      text-align: center;
      white-space: nowrap;
      pointer-events: none;
    }
    .toast-container.show { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
  </style>
</head>
