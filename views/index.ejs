  <script>
    let toastTimer;
    let currentUserData = null;
    let currentDepositAmount = 50;
    let paymentTimerInterval = null;
    let currentWdMethod = 'bank';

    function showToast(msg) {
      const toast = document.getElementById('app-toast');
      toast.innerText = msg;
      toast.classList.add('show');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { toast.classList.remove('show'); }, 2500);
    }

    function handleImgErr(img, fallbacks) {
      if (!img.dataset.tryCount) img.dataset.tryCount = 0;
      let count = parseInt(img.dataset.tryCount);
      if (count < fallbacks.length) {
        img.src = fallbacks[count];
        img.dataset.tryCount = count + 1;
      }
    }

    function closePromoBanner() {
      const banner = document.getElementById('top-promo-section');
      if (banner) banner.style.display = 'none';
    }

    function openLoadingGateway() { window.location.href = '/loading-gateway'; }

    function openRegisterView() {
      closeAllViews();
      document.getElementById('register-fullscreen-view').style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function openLoginView() {
      closeAllViews();
      document.getElementById('login-fullscreen-view').style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeAuthViews() {
      document.getElementById('register-fullscreen-view').style.display = 'none';
      document.getElementById('login-fullscreen-view').style.display = 'none';
      document.body.style.overflow = '';
    }

    function switchToLogin() {
      document.getElementById('register-fullscreen-view').style.display = 'none';
      document.getElementById('login-fullscreen-view').style.display = 'flex';
    }

    function switchToRegister() {
      document.getElementById('login-fullscreen-view').style.display = 'none';
      document.getElementById('register-fullscreen-view').style.display = 'flex';
    }

    function openProfileView() {
      const isLogged = document.getElementById('user-zone').style.display !== 'none';
      if (!isLogged) return openLoginView();
      closeAllViews();
      document.getElementById('profile-fullscreen-view').style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeProfileView() {
      document.getElementById('profile-fullscreen-view').style.display = 'none';
      document.body.style.overflow = '';
    }

    function openPromoView() {
      closeAllViews();
      document.getElementById('promo-view').style.display = 'flex';
      document.body.style.overflow = 'hidden';
      filterPromos('ALL', document.querySelector('#promo-cat-tabs .promo-cat-pill'));
    }

