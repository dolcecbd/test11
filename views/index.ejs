      const isLogged = document.getElementById('user-zone').style.display !== 'none';
      if (!isLogged) return openLoginView();
      closeAllViews();
      document.getElementById('deposit-view').style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeDepositView() {
      document.getElementById('deposit-view').style.display = 'none';
      document.body.style.overflow = '';
    }

    function closeAllViews() {
      closeAuthViews();
      closeProfileView();
      closePromoView();
      closeRebateView();
      closeWithdrawView();
      closeDepositView();
    }

    function togglePassView(inputId) {
      const el = document.getElementById(inputId);
      if (el) el.type = el.type === 'password' ? 'text' : 'password';
    }

    function copyUsername() {
      const u = document.getElementById('display-username').innerText;
      navigator.clipboard.writeText(u).then(() => {
        showToast('Đã sao chép tài khoản: ' + u);
      });
    }

    function updateBalanceUI(balanceNumber) {
      const num = Number(balanceNumber || 0);
      const textK = num >= 1000 ? (num / 1000).toFixed(2).replace(/\.00$/, '') + 'K' : num + 'K';
      document.getElementById('display-balance').innerText = textK;
      document.getElementById('prof-balance-text').innerText = textK;
      const wdBal = document.getElementById('wd-available-balance');
      if (wdBal) wdBal.innerText = textK;
    }

    /* ĐĂNG KÝ / ĐĂNG NHẬP */
    async function handleRegisterSubmit(e) {
      e.preventDefault();
      const username = document.getElementById('reg-username').value.trim();
      const password = document.getElementById('reg-password').value.trim();
      const fullName = document.getElementById('reg-fullname').value.trim().toUpperCase();
      const phone = document.getElementById('reg-phone').value.trim();

      try {
        const res = await fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password, fullName, phone })
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message);
          currentUserData = data.user;
          localStorage.setItem('qq88_user', JSON.stringify(data.user));
          closeAuthViews();
          applyLoggedInState(data.user);
        } else {
          showToast(data.message);
        }
      } catch (err) {
        showToast('Lỗi kết nối máy chủ!');
      }
    }

    async function handleLoginSubmit(e) {
      e.preventDefault();
      const username = document.getElementById('login-username').value.trim();
      const password = document.getElementById('login-password').value.trim();

      try {
        const res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message);
          currentUserData = data.user;
