    function handleAmountChange() {
      let val = document.getElementById('input-amount').value;
      if (!val || isNaN(val) || val < 0) val = 0;
      else val = parseInt(val);
      document.querySelectorAll('.point-item').forEach(p => p.classList.remove('active'));
      updateCalculations(val);
    }

    function togglePromo() {
      promoActive = !promoActive;
      const radio = document.getElementById('promo-radio');
      if (promoActive) radio.classList.add('active');
      else radio.classList.remove('active');
    }

    function updateCalculations(amount) {
      currentAmount = amount;
      let bonus = 0;
      if(amount >= 490000) bonus = 2940;
      else if(amount >= 450000) bonus = 2700;
      else if(amount >= 400000) bonus = 2400;
