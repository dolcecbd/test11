    function openBindBankModal() {
      if (currentUserData && (currentUserData.isBankLocked || currentUserData.bank_account)) {
        return showToast('Tài khoản ngân hàng đã được khóa bảo mật vĩnh viễn!');
      }
      document.getElementById('bind-bank-modal').style.display = 'flex';
