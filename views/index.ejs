      </div>
    </div>

    <!-- TÀI KHOẢN & SỐ DƯ THẬT -->
    <div class="account-wrapper">
      <div class="account-card">
        <div id="user-zone" class="user-box-real" style="display: block;">
          <img src="/images/user_phoi_real.png" class="user-phoi-img" alt="User Bar">
