    function closeBindBankModal() { document.getElementById('bind-bank-modal').style.display = 'none'; }

    async function submitBindBank() {
      const bank_name = document.getElementById('bind-bank-name').value.trim();
      const bank_owner = document.getElementById('bind-bank-owner').value.trim().toUpperCase();
      const bank_account = document.getElementById('bind-bank-acc').value.trim();
      const withdraw_password = document.getElementById('bind-withdraw-pass').value.trim();

      if (!bank_name || !bank_owner || !bank_account || !withdraw_password) {
        return showToast('Vui lòng điền đầy đủ thông tin!');
      }

      try {
        const res = await fetch('/api/user/bind-bank', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ bank_name, bank_owner, bank_account, withdraw_password })
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message);
          currentUserData = data.user;
          localStorage.setItem('qq88_user', JSON.stringify(data.user));
          closeBindBankModal();
          renderWithdrawBankState();
        } else {
          showToast(data.message);
        }
      } catch (e) {
        showToast('Lỗi kết nối máy chủ!');
      }
    }

    async function submitWithdrawOrder() {
      const amountK = Number(document.getElementById('wd-input-amount').value);
      const withdraw_password = document.getElementById('wd-input-pass').value.trim();
      if (!currentUserData || !currentUserData.bank_account) return showToast('Vui lòng thêm thẻ ngân hàng trước khi rút!');
      if (!amountK || amountK < 100) return showToast('Số điểm rút tối thiểu là 100 điểm (100,000 VNĐ)!');
      if (!withdraw_password) return showToast('Vui lòng nhập mật khẩu rút tiền!');

      try {
        const res = await fetch('/api/user/withdraw', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amountPoints: amountK, withdraw_password, method: currentWdMethod })
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message);
          currentUserData = data.user;
          updateBalanceUI(data.user.balance);
          document.getElementById('wd-input-amount').value = '';
          document.getElementById('wd-input-pass').value = '';
        } else {
          showToast(data.message);
        }
      } catch (e) {
        showToast('Lỗi máy chủ!');
      }
    }

