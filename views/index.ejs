    function handleDepositNext() {
      const transId = 'VND' + Math.floor(100000000 + Math.random() * 900000000) + 'VN' + Math.floor(1000000 + Math.random() * 9000000);
      document.getElementById('deposit-view').style.display = 'none';
      document.getElementById('payment-confirm-view').style.display = 'block';

      const totalVND = currentDepositAmount * 1000;
      document.getElementById('pc-amount').innerText = totalVND.toLocaleString('en-US') + ' VND';
      document.getElementById('pc-trans-id').innerText = transId;
      document.getElementById('pc-memo').innerText = transId;

      const now = new Date();
      const pad = (n) => String(n).padStart(2, '0');
      document.getElementById('pc-time').innerText = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;

      let timer = 600;
      if (paymentTimerInterval) clearInterval(paymentTimerInterval);
      paymentTimerInterval = setInterval(() => {
        let m = parseInt(timer / 60, 10);
        let s = parseInt(timer % 60, 10);
        document.getElementById('pc-timer-text').innerText = (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
        if (--timer < 0) {
          clearInterval(paymentTimerInterval);
          closePaymentConfirm();
        }
      }, 1000);
    }

    function closePaymentConfirm() {
      if (paymentTimerInterval) clearInterval(paymentTimerInterval);
      document.getElementById('payment-confirm-view').style.display = 'none';
      document.getElementById('deposit-view').style.display = 'flex';
    }

