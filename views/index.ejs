    <!-- VÙNG HIỂN THỊ DANH SÁCH GAME -->
    <div id="game-content-viewport"></div>

    <!-- BOTTOM NAV -->
    <div class="bottom-nav">
      <div class="nav-item active"><svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg><span>TRANG CHỦ</span></div>
      <div class="nav-item" onclick="showToast('Khuyến mãi')"><svg viewBox="0 0 24 24"><path d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.1.9 2 2 2h16c1.1 0 2-.89 2-2V8c0-1.1-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76V14h2V8.76L15.38 12 17 10.83 14.92 8H20v6z"/></svg><span>KHUYẾN MÃI</span></div>
      <div class="nav-item" onclick="showToast('Tải App')"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S2 6.48 2 12zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/></svg><span>TẢI APP</span></div>
      <div class="nav-item" onclick="showToast('Hỗ trợ')"><svg viewBox="0 0 24 24"><path d="M12 1a9 9 0 0 0-9 9v7c0 1.66 1.34 3 3 3h3v-8H5v-2c0-3.87 3.13-7 7-7s7 3.13 7 7v2h-4v8h3c1.66 0 3-1.34 3-3v-7a9 9 0 0 0-9-9z"/></svg><span>LIÊN HỆ</span></div>
      <div class="nav-item" onclick="openUserMenu()"><svg viewBox="0 0 24 24"><path d="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z"/></svg><span>CẨM NANG</span></div>
    </div>

  </div>

  <!-- GIAO DIỆN NẠP TIỀN -->
  <div id="deposit-view" class="deposit-view-wrapper">
    <div class="deposit-header">
      <div class="btn-back" onclick="closeDepositView()">⟨</div>
      <div class="deposit-title">Nạp Tiền</div>
    </div>
    <div class="deposit-body">
      <div class="deposit-sec-title"><span class="dot-orange"></span><span>Chọn số điểm nạp (K)</span></div>
      <div class="points-grid">
        <div class="point-item active" onclick="selectPoint(this, 50)">50</div>
        <div class="point-item" onclick="selectPoint(this, 100)">100</div>
        <div class="point-item" onclick="selectPoint(this, 500)">500</div>
        <div class="point-item" onclick="selectPoint(this, 1000)">1,000</div>
        <div class="point-item" onclick="selectPoint(this, 50000)">50,000</div>
      </div>
      <div class="btn-deposit-next" onclick="handleDepositNext()">Tiếp theo (Mở mã QR nạp tiền)</div>
    </div>
  </div>

  <!-- MÀN HÌNH QR NẠP TIỀN THỰC TẾ -->
  <div id="payment-confirm-view" class="deposit-view-wrapper no-scrollbar">
    <div class="pay-confirm-header">
      <div class="bank-logo">ACB</div>
      <div class="header-actions">
        <div class="btn-pc-cancel" onclick="closePaymentConfirm()">HỦY BỎ</div>
      </div>
    </div>
    <div class="pay-info-card">
      <div class="pay-info-row">
        <span class="pay-info-label">SỐ TIỀN THANH TOÁN</span>
        <span class="pay-info-value amount red" id="pc-amount">50,000 VND</span>
      </div>
    </div>
    <div class="pay-qr-card" style="text-align: center;">
      <div class="qr-box" style="width: 200px; height: 200px; margin: 0 auto;">
        <img id="pc-qr-img" src="/images/qr_acb.png" alt="QR Code">
      </div>
    </div>
    <div class="btn-check-result" onclick="confirmDepositDone()">
      Xác nhận đã chuyển khoản thành công (+ Tiền vào ví)
    </div>
  </div>

  <!-- MODAL ĐĂNG NHẬP / ĐĂNG KÝ -->
  <div id="auth-modal" class="modal-overlay">
    <div class="modal-content">
      <button class="modal-close" onclick="closeAuthModal()">✕</button>
      <div class="modal-tabs">
        <div id="tab-login" class="modal-tab-btn active" onclick="switchAuthTab('login')">ĐĂNG NHẬP</div>
        <div id="tab-register" class="modal-tab-btn" onclick="switchAuthTab('register')">ĐĂNG KÝ</div>
      </div>
      <form id="auth-form" onsubmit="handleAuthSubmit(event)">
        <div class="input-group">
          <label class="input-label">Tên tài khoản</label>
          <input type="text" id="input-username" class="input-field" required autocomplete="off">
        </div>
        <div class="input-group">
          <label class="input-label">Mật khẩu</label>
          <input type="password" id="input-password" class="input-field" required>
        </div>
        <button type="submit" id="btn-modal-action" class="btn-submit">ĐĂNG NHẬP</button>
      </form>
    </div>
  </div>

  <!-- IFRAME MỞ TỪNG GAME ĐỘC LẬP -->
  <div id="game-play-modal" style="display:none; position:fixed; top:0; left:50%; transform:translateX(-50%); width:100%; max-width:430px; height:100vh; background:#000; z-index:100005; flex-direction:column;">
    <div style="height:44px; background:#18191d; display:flex; align-items:center; padding:0 10px; color:#fff; flex-shrink:0;">
      <div onclick="closeGame()" style="font-size:24px; cursor:pointer; width:30px; line-height:44px;">⟨</div>
      <div id="playing-game-title" style="flex:1; text-align:center; font-size:14px; font-weight:bold; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Tên Game</div>
      <div style="width:30px;"></div>
    </div>
    <div style="flex:1; background:#000; position:relative;">
      <div id="game-loader" style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); color:#fff; font-size:13px; font-weight:bold;">Đang kết nối sảnh game...</div>
      <iframe id="game-iframe" src="" style="width:100%; height:100%; border:none; position:relative; z-index:2; background:#000; display:none;"></iframe>
    </div>
  </div>

  <script>
    let toastTimer;
    function showToast(msg) {
      const toast = document.getElementById('app-toast');
      toast.innerText = msg;
      toast.classList.add('show');
      if(toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove('show'), 2500);
    }

    function handleImgErr(img, fallbacks) {
      if (!img.dataset.tryCount) img.dataset.tryCount = 0;
      let count = parseInt(img.dataset.tryCount);
      if (count < fallbacks.length) {
        img.src = fallbacks[count];
        img.dataset.tryCount = count + 1;
      }
    }

    function closePromoBanner() {
      document.getElementById('top-promo-section').style.display = 'none';
    }

    function openSidebar() {
      document.getElementById('sidebar-drawer').classList.add('open');
      document.getElementById('sidebar-overlay').classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      document.getElementById('sidebar-drawer').classList.remove('open');
      document.getElementById('sidebar-overlay').classList.remove('open');
      document.body.style.overflow = '';
    }

    function handleMenuClick(action) {
      closeSidebar();
      if(action === 'facebook') window.open('https://facebook.com', '_blank');
      else showToast('Đã chuyển hướng mục hỗ trợ');
    }

    function handleSidebarAuth() {
      closeSidebar();
      logoutAccount();
    }

    /* ĐỊNH TUYẾN SLUG CHO 50 GAME */
    function getGameSlug(gameName) {
      const normalized = (gameName || '').toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .replace(/[^a-z0-9]/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');
      if (normalized.includes('cao-boi') || normalized.includes('quyet-chien') || normalized.includes('slot')) return 'slot-caoboi';
      if (normalized.includes('danh-ca') || normalized.includes('ban-ca')) return 'banca-jackpot';
      if (normalized.includes('tai-xiu')) return 'gamebai-taixiu';
      return normalized || 'slot-caoboi';
    }

    /* MỞ CON GAME ĐỘC LẬP TƯƠNG ỨNG */
    function launchGame(gameItem) {
      const gameName = typeof gameItem === 'object' ? gameItem.name : gameItem;
      const gameCode = (typeof gameItem === 'object' && gameItem.code) ? gameItem.code : getGameSlug(gameName);

      const modal = document.getElementById('game-play-modal');
      const title = document.getElementById('playing-game-title');
      const iframe = document.getElementById('game-iframe');
      const loader = document.getElementById('game-loader');

      modal.style.display = 'flex';
      title.innerText = gameName;
      iframe.style.display = 'none';
      loader.style.display = 'block';
      document.body.style.overflow = 'hidden';

      setTimeout(() => {
        loader.style.display = 'none';
        iframe.style.display = 'block';
        // TRỎ ĐÚNG ĐƯỜNG DẪN ĐỘNG CỦA TỪNG GAME TRÊN SERVER
        iframe.src = '/game/' + gameCode;
      }, 500);
    }

    function closeGame() {
      document.getElementById('game-play-modal').style.display = 'none';
      document.getElementById('game-iframe').src = '';
      document.body.style.overflow = '';
      syncBalanceFromServer();
    }

    /* DỮ LIỆU SẢNH GAME ĐẦY ĐỦ */
    const partnerRooms = {
      casino: [
        { name: "SE TRỰC TUYẾN", file: "sanh_se.png", code: "casino-se" },
        { name: "DG TRỰC TUYẾN", file: "sanh_dg.png", code: "casino-dg" },
        { name: "MT TRỰC TUYẾN", file: "sanh_wm.png", code: "casino-mt" },
        { name: "EVO TRỰC TUYẾN", file: "sanh_evo.png", code: "casino-evo" }
      ],
      thethao: [
        { name: "SABA THỂ THAO", file: "sanh_saba.png", code: "thethao-saba" },
        { name: "CMD THỂ THAO", file: "sanh_cmd.png", code: "thethao-cmd" }
      ],
      daga: [
        { name: "SV388 ĐÁ GÀ", file: "sanh_sv388.png", code: "daga-sv388" },
        { name: "GA28 ĐÁ GÀ", file: "sanh_ga28.png", code: "daga-ga28" }
      ],
      xoso: [
        { name: "TCG XỔ SỐ", file: "sanh_tcg.png", code: "xoso-tcg" }
      ],
      esports: [
        { name: "IA E-SPORTS", file: "sanh_ia.png", code: "esports-ia" }
      ]
    };

    const brandLists = {
      nohu: [
        { id: "all", name: "Tất cả" },
        { id: "pg", name: "PG", file: "hang_pg.png" },
        { id: "jili", name: "JILI", file: "hang_jili.png" }
      ],
      banca: [
        { id: "all", name: "Tất cả" },
        { id: "jili", name: "JILI", file: "hang_jili.png" }
      ],
      gamebai: [
        { id: "all", name: "Tất cả" },
        { id: "v8", name: "V8", file: "hang_v8.png" }
      ]
    };

    const slotGamesData = {
      banca: [
        { name: "Jackpot Đánh Cá", brand: "jili", tagLogo: "JILI", file: "JACKPOT DANH CA.png", code: "banca-jackpot" },
        { name: "Bắn Cá Thần Tài", brand: "jdb", tagLogo: "JDB", file: "BAN CA THAN TAI.png", code: "banca-thantai" }
      ],
      nohu: [
        { name: "Quyết Chiến Tiền Thưởng", brand: "pg", tagLogo: "PG", file: "QUYẾT CHIẾN TIEN THUG_.png", code: "slot-caoboi" },
        { name: "Đường Mạt Chược 2", brand: "pg", tagLogo: "PG", file: "DUONG MAT CHUOC 2.png", code: "slot-caoboi" }
      ],
      gamebai: [
        { name: "Tài Xỉu", brand: "v8", tagLogo: "V8", file: "TAI Xiu.png", code: "gamebai-taixiu" },
        { name: "Xóc Đĩa", brand: "v8", tagLogo: "V8", file: "XÓC ĐĨA_.png", code: "gamebai-xocdia" }
      ]
    };

    const gameListHot = [
      { name: "QQUYẾT CHIẾN TIỀN THƯỞNG", files: ["QUYẾT CHIẾN TIEN THUG_.png"], code: "slot-caoboi" },
      { name: "JACKPOT ĐÁNH CÁ", files: ["JACKPOT DANH CA.png"], code: "banca-jackpot" },
      { name: "TÀI XỈU", files: ["TAI Xiu.png"], code: "gamebai-taixiu" },
      { name: "XÓC ĐĨA", files: ["XÓC ĐĨA_.png"], code: "gamebai-xocdia" }
    ];

    let currentMainCat = 'hot';
    let currentActiveBrand = 'all';

    function renderViewport() {
      const viewport = document.getElementById('game-content-viewport');
      const subHeader = document.getElementById('sub-filter-header');
      viewport.innerHTML = '';

      if (partnerRooms[currentMainCat]) {
        subHeader.style.display = 'none';
        const grid = document.createElement('div');
        grid.className = 'partner-grid-2col';

        partnerRooms[currentMainCat].forEach(room => {
          const card = document.createElement('div');
          card.className = 'partner-card-box';
          card.onclick = () => launchGame(room);

          const img = document.createElement('img');
          img.src = '/images/' + encodeURIComponent(room.file);
          img.onerror = function() { this.src = '/images/' + room.file.replace('.png', '.jpg'); };
          card.appendChild(img);
          grid.appendChild(card);
        });
        viewport.appendChild(grid);
        return;
      }

      if (brandLists[currentMainCat]) {
        subHeader.style.display = 'block';
        const container = document.createElement('div');
        container.className = 'slot-layout-container';

        const leftSidebar = document.createElement('div');
        leftSidebar.className = 'brand-sidebar-left';

        brandLists[currentMainCat].forEach(brand => {
          const btn = document.createElement('div');
          btn.className = 'brand-btn-item' + (currentActiveBrand === brand.id ? ' active' : '');
          btn.onclick = () => { currentActiveBrand = brand.id; renderViewport(); };
          if (brand.id === 'all') {
            btn.innerHTML = `<span style="font-size:12px;font-weight:900;">${brand.name}</span>`;
          } else {
            btn.innerHTML = `<img src="/images/${brand.file}" onerror="this.style.display='none'"><span>${brand.name}</span>`;
          }
          leftSidebar.appendChild(btn);
        });

        const rightGrid = document.createElement('div');
        rightGrid.className = 'slot-game-grid-right';

        let list = slotGamesData[currentMainCat] || [];
        if (currentActiveBrand !== 'all') {
          list = list.filter(g => g.brand === currentActiveBrand);
        }

        list.forEach(g => {
          const card = document.createElement('div');
          card.className = 'slot-card-box';
          card.onclick = () => launchGame(g);
          card.innerHTML = `
            <div class="slot-poster-frame">
              <span class="slot-tag-hot">HOT</span>
              <img src="/images/${encodeURIComponent(g.file)}" onerror="this.src='/images/${encodeURIComponent(g.file.replace('.png', '.jpg'))}'" alt="${g.name}">
              <span class="slot-brand-logo-badge">${g.tagLogo}</span>
            </div>
            <div class="slot-game-title-row">
              <div class="slot-title-text">${g.name}</div>
            </div>
          `;
          rightGrid.appendChild(card);
        });

        container.appendChild(leftSidebar);
        container.appendChild(rightGrid);
        viewport.appendChild(container);
        return;
      }

      subHeader.style.display = 'none';
      const hotGrid = document.createElement('div');
      hotGrid.className = 'game-grid-hot';

      gameListHot.forEach(g => {
        const cardBox = document.createElement('div');
        cardBox.className = 'game-card-wrapper';
        cardBox.onclick = () => launchGame(g);

        const img = document.createElement('img');
        img.className = 'game-card-img';
        img.src = '/images/' + encodeURIComponent(g.files[0]);
        img.onerror = function() { this.src = '/images/' + g.files[0].replace('.png', '.jpg'); };
        cardBox.appendChild(img);
        hotGrid.appendChild(cardBox);
      });
      viewport.appendChild(hotGrid);
    }

    function switchCategory(cat, element) {
      currentMainCat = cat;
      currentActiveBrand = 'all';
      document.querySelectorAll('.cat-tab-item').forEach(t => t.classList.remove('active'));
      element.classList.add('active');
      renderViewport();
    }

    function handleSearchGame(kw) {
      const k = kw.trim().toLowerCase();
      document.querySelectorAll('.slot-card-box').forEach(c => {
        const name = c.querySelector('.slot-title-text').innerText.toLowerCase();
        c.style.display = name.includes(k) ? 'flex' : 'none';
      });
    }

    function navScroll(offset) {
      document.getElementById('cat-list').scrollLeft += offset;
    }

    function openDepositView() {
      document.getElementById('deposit-view').style.display = 'flex';
    }
    function closeDepositView() {
      document.getElementById('deposit-view').style.display = 'none';
    }

    let depositAmountK = 50;
    function selectPoint(el, amt) {
      document.querySelectorAll('.point-item').forEach(p => p.classList.remove('active'));
      el.classList.add('active');
      depositAmountK = amt;
    }

    function handleDepositNext() {
      document.getElementById('deposit-view').style.display = 'none';
      document.getElementById('payment-confirm-view').style.display = 'block';
      document.getElementById('pc-amount').innerText = (depositAmountK * 1000).toLocaleString('en-US') + ' VND';
    }

    function closePaymentConfirm() {
      document.getElementById('payment-confirm-view').style.display = 'none';
      document.getElementById('deposit-view').style.display = 'flex';
    }

    async function confirmDepositDone() {
      showToast('Đang xác thực giao dịch chuyển khoản...');
      try {
        const depositVND = depositAmountK * 1000;
        const res = await fetch('/api/deposit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount: depositVND })
        });
        const data = await res.json();
        if (data && data.new_balance !== undefined) {
          showToast(`Nạp thành công +${depositVND.toLocaleString('vi-VN')} VND!`);
          updateUserBalanceDisplay(data.new_balance);
          closePaymentConfirm();
          closeDepositView();
        } else {
          showToast('Xác thực thất bại!');
        }
      } catch (err) {
        showToast('Lỗi kết nối máy chủ!');
      }
    }

    function updateUserBalanceDisplay(newBalance) {
      const balanceEl = document.getElementById('display-balance');
      if (balanceEl) {
        balanceEl.innerText = Number(newBalance).toLocaleString('vi-VN') + ' đ';
      }
    }

    async function syncBalanceFromServer() {
      try {
        const res = await fetch('/api/me');
        const data = await res.json();
        if (data && data.user && data.user.balance !== undefined) {
          updateUserBalanceDisplay(data.user.balance);
        }
      } catch (e) {}
    }

    function copyUsername() {
      const u = document.getElementById('display-username').innerText;
      navigator.clipboard.writeText(u).then(() => showToast('Đã sao chép: ' + u));
    }

    function openAuthModal(mode) { openAuthModalTab(mode); }
    function closeAuthModal() { document.getElementById('auth-modal').style.display = 'none'; }
    function switchAuthTab(m) {}

    async function handleAuthSubmit(e) {
      e.preventDefault();
      const username = document.getElementById('input-username').value.trim();
      const password = document.getElementById('input-password').value.trim();
      try {
        const res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message);
          closeAuthModal();
          checkSession();
        } else {
          // Thử đăng ký nếu chưa có
          const regRes = await fetch('/api/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password })
          });
          const regData = await regRes.json();
          showToast(regData.message);
          if (regData.success) { closeAuthModal(); checkSession(); }
        }
      } catch (err) { showToast('Lỗi kết nối!'); }
    }

    async function checkSession() {
      try {
        let res = await fetch('/api/me');
        let data = await res.json();
        if (data && data.loggedIn && data.user) {
          document.getElementById('display-username').innerText = data.user.username;
          updateUserBalanceDisplay(data.user.balance || 0);
        }
      } catch (e) {}
    }

    async function logoutAccount() {
      await fetch('/api/logout', { method: 'POST' });
      checkSession();
      showToast('Đã đăng xuất!');
    }

    window.onload = () => {
      renderViewport();
      checkSession();
    };
  </script>
</body>
</html>
