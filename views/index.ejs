  <script>
    let toastTimer;
    function showToast(msg) {
      const toast = document.getElementById('app-toast');
      toast.innerText = msg;
      toast.classList.add('show');
      if(toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { toast.classList.remove('show'); }, 2500);
    }

    function handleImgErr(img, fallbacks) {
      if (!img.dataset.tryCount) img.dataset.tryCount = 0;
      let count = parseInt(img.dataset.tryCount);
      if (count < fallbacks.length) {
        img.src = fallbacks[count];
        img.dataset.tryCount = count + 1;
      }
    }

    function closePromoBanner() {
      const banner = document.getElementById('top-promo-section');
      if (banner) banner.style.display = 'none';
    }

    function openSidebar() {
      document.getElementById('sidebar-drawer').classList.add('open');
      document.getElementById('sidebar-overlay').classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      document.getElementById('sidebar-drawer').classList.remove('open');
      document.getElementById('sidebar-overlay').classList.remove('open');
      document.body.style.overflow = '';
    }

    function handleMenuClick(action) {
