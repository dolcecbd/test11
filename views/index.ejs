      showToast('Đang cộng điểm vào tài khoản...');
      try {
        const depositVND = currentAmount * 1000;
        const res = await fetch('/api/deposit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount: depositVND })
        });
        const data = await res.json();
        if (data && data.new_balance !== undefined) {
          showToast(`Nạp thành công +${depositVND.toLocaleString('vi-VN')} đ!`);
          updateUserBalanceDisplay(data.new_balance);
          closePaymentConfirm();
          closeDepositView();
        } else {
          showToast('Nạp tiền không thành công!');
        }
      } catch (err) {
        showToast('Lỗi kết nối máy chủ!');
      }
    }

    /* CẬP NHẬT HIỂN THỊ SỐ TIỀN DẠNG K CHUẨN XÁC THEO WEB THẬT */
    function updateUserBalanceDisplay(newBalance) {
      const balanceEl = document.getElementById('display-balance');
      if (balanceEl) {
        const num = Number(newBalance || 0);
        const inK = num >= 1000 ? Math.floor(num / 1000).toLocaleString('vi-VN') + 'K' : num + 'K';
        balanceEl.innerText = inK;
      }
      const backup = localStorage.getItem('qq88_saved_account');
      if (backup) {
        try {
          const u = JSON.parse(backup);
          u.balance = Number(newBalance);
          localStorage.setItem('qq88_saved_account', JSON.stringify(u));
        } catch(e) {}
      }
    }

