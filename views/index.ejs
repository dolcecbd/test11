async function handleRealLogin(e) {
  e.preventDefault();
  const username = document.getElementById('login-input-user').value.trim();
  const password = document.getElementById('login-input-pass').value.trim();
  try {
    const res = await fetch('/api/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, password })
    });
    const data = await res.json();
    if (data.success) {
      showToast(data.message);
      localStorage.setItem('qq88_saved_account', JSON.stringify(data.user));
      syncProfileGoldCard(data.user);
      closeAuthOverlay('login');
      checkSession();
    } else {
      showToast(data.message || 'Đăng nhập thất bại!');
    }
  } catch (err) {
    showToast('Lỗi kết nối máy chủ!');
  }
}

    async function handleRealRegister(e) {
      e.preventDefault();
      const username = document.getElementById('reg-input-user').value.trim();
      const password = document.getElementById('reg-input-pass').value.trim();
      const fullname = document.getElementById('reg-input-fullname').value.trim();
      const phone = document.getElementById('reg-input-phone').value.trim();

      try {
        const res = await fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password, fullname, phone })
        });
        const data = await res.json();
        if (data.success) {
          showToast('Đăng ký thành công!');
          localStorage.setItem('qq88_saved_account', JSON.stringify(data.user));
          closeAuthOverlay('register');
          checkSession();
        } else {
          showToast(data.message || 'Đăng ký thất bại!');
        }
      } catch (err) {
        showToast('Lỗi kết nối máy chủ!');
      }
    }

    // Gán đè hàm cũ để mở đúng màn hình John Terry
    openAuthModal = function(mode) {
      openAuthOverlay(mode);
    };

    // 4. MÀN HÌNH KHUYẾN MÃI THEO TAB
    function openPromoView() {
      document.getElementById('overlay-promo-view').style.display = 'flex';
      document.body.style.overflow = 'hidden';
      filterPromoCards('hot', document.querySelector('.km-tab-btn.active'));
    }

    function closePromoView() {
      document.getElementById('overlay-promo-view').style.display = 'none';
      document.body.style.overflow = '';
    }

    function filterPromoCards(category, btnEl) {
      if (btnEl) {
        document.querySelectorAll('.km-tab-btn, .km-tab-full').forEach(b => b.classList.remove('active'));
        btnEl.classList.add('active');
      }
      const container = document.getElementById('km-card-container');
      container.innerHTML = '';

      let list = promoData;
      if (category !== 'all') {
        list = promoData.filter(item => item.cat.includes(category));
      }

      list.forEach(p => {
        const card = document.createElement('div');
        card.className = 'km-card-item';
        card.onclick = () => showToast(`Xem chi tiết khuyến mãi: ${p.id}`);
        card.innerHTML = `<img src="/images/${p.file}" onerror="handleImgErr(this, ['/images/${p.file.replace('.png', '.jpg')}'])" alt="${p.id}">`;
        container.appendChild(card);
      });
    }

    // 5. MÀN HÌNH PROFILE & HOÀN TRẢ
    function openUserProfile() {
      const isLogged = document.getElementById('user-zone').style.display !== 'none';
      if (!isLogged) {
        openAuthOverlay('login');
        return;
      }
      document.getElementById('overlay-user-profile').style.display = 'flex';
      document.body.style.overflow = 'hidden';

      const u = document.getElementById('display-username').innerText;
      const b = document.getElementById('display-balance').innerText;
      document.getElementById('acc-username-val').innerText = u;
      document.getElementById('acc-balance-val').innerText = b;
    }

    function closeProfileView() {
      document.getElementById('overlay-user-profile').style.display = 'none';
      document.body.style.overflow = '';
    }

    function openRefundView() {
      document.getElementById('overlay-refund-view').style.display = 'flex';
      document.body.style.overflow = 'hidden';
      const today = new Date().toISOString().split('T')[0];
      const dateEl = document.getElementById('refund-stat-date');
      if (dateEl) dateEl.innerText = today;
    }

    function closeRefundView() {
      document.getElementById('overlay-refund-view').style.display = 'none';
      document.body.style.overflow = '';
    }

    // 6. MÀN HÌNH RÚT TIỀN (3 TAB & BIND BANK)
    let currentWithdrawTab = 'bank';

    function openWithdrawView() {
      const isLogged = document.getElementById('user-zone').style.display !== 'none';
      if (!isLogged) {
        openAuthOverlay('login');
        return;
      }
      document.getElementById('overlay-withdraw-view').style.display = 'flex';
      document.body.style.overflow = 'hidden';

      const b = document.getElementById('display-balance').innerText;
      const availEl = document.getElementById('w-avail-balance');
      if (availEl) availEl.innerText = b;

      switchWithdrawTab(currentWithdrawTab);
    }

    function closeWithdrawView() {
      document.getElementById('overlay-withdraw-view').style.display = 'none';
      document.body.style.overflow = '';
    }

    function switchWithdrawTab(tab) {
      currentWithdrawTab = tab;
      document.querySelectorAll('.withdraw-tab-item').forEach(t => t.classList.remove('active'));
      const activeBtn = document.getElementById(`wtab-btn-${tab}`);
      if (activeBtn) activeBtn.classList.add('active');

      const countEl = document.getElementById('wcard-title-count');
      const imgEl = document.getElementById('wcard-empty-img');
      const descEl = document.getElementById('wcard-empty-desc');

      if (tab === 'bank') {
        countEl.innerText = 'Thẻ ngân hàng của tôi(0/3)';
        imgEl.src = '/images/card_empty_bank.png';
        descEl.innerText = 'Thẻ ngân hàng trống';
      } else if (tab === 'crypto') {
        countEl.innerText = 'Ví của tôi(0/2)';
        imgEl.src = '/images/card_empty_crypto.png';
        descEl.innerText = 'Danh sách ví trống';
      } else {
        countEl.innerText = 'Bị ràng buộc MOMO (0/1)';
        imgEl.src = '/images/card_empty_momo.png';
        descEl.innerText = 'Ví điện tử rỗng';
      }
    }

    function openAddBankModal() {
      const backup = localStorage.getItem('qq88_saved_account');
      let fullname = 'NGUOI DUNG';
      if (backup) {
        try {
          const u = JSON.parse(backup);
          if (u.bank_owner) fullname = u.bank_owner;
          else if (u.fullname) fullname = u.fullname.toUpperCase();
        } catch(e) {}
      }
      document.getElementById('bind-bank-owner').value = fullname;
      document.getElementById('modal-bind-bank').style.display = 'flex';
    }

    function closeAddBankModal() {
      document.getElementById('modal-bind-bank').style.display = 'none';
    }

    async function submitBindBank() {
      const bank_name = document.getElementById('bind-bank-select').value;
      const bank_account = document.getElementById('bind-bank-acc').value.trim();
      const p1 = document.getElementById('bind-w-pass').value;
      const p2 = document.getElementById('bind-w-pass-re').value;

      if (!bank_account) return showToast('Vui lòng nhập số tài khoản!');
      if (!p1 || p1 !== p2) return showToast('Mật khẩu rút tiền không trùng khớp!');

      try {
        const res = await fetch('/api/user/bind-bank', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ bank_name, bank_account, withdraw_password: p1 })
        });
        const data = await res.json();
        if (data.success) {
          showToast('Liên kết thẻ ngân hàng thành công! Đã khóa bảo mật.');
          closeAddBankModal();
          checkSession();
        } else {
          showToast(data.message || 'Lỗi liên kết thẻ!');
        }
      } catch (e) {
        showToast('Lỗi máy chủ!');
      }
    }

    function submitWithdrawal() {
      const amt = document.getElementById('w-input-amount').value;
      const pass = document.getElementById('w-input-pass').value;
      if (!amt || Number(amt) < 100) return showToast('Hạn mức rút tối thiểu 100 điểm!');
      if (!pass) return showToast('Vui lòng nhập mật khẩu rút tiền!');
      showToast('Lệnh rút tiền đang được hệ thống phê duyệt...');
    }

    // 7. HOÁN ĐỔI THANH BOTTOM NAV CHUẨN XÁC GIỮA KHÁCH & HỘI VIÊN
    function applyDynamicBottomNav(isLoggedIn) {
      const centerSlot = document.getElementById('nav-slot-center');
      const centerText = document.getElementById('nav-text-center');
      const rightSlot = document.getElementById('nav-slot-right');
      const rightText = document.getElementById('nav-text-right');

      if (!centerSlot || !rightSlot) return;

      if (isLoggedIn) {
        // HỘI VIÊN: HOÀN TRẢ & TÀI KHOẢN
        centerText.innerText = 'HOÀN TRẢ';
        centerSlot.onclick = () => openRefundView();
        centerSlot.querySelector('svg').innerHTML = '<circle cx="12" cy="12" r="10" fill="none" stroke="#829288" stroke-width="2"/><text x="12" y="16.5" text-anchor="middle" fill="#829288" font-size="14" font-weight="bold">$</text>';

        rightText.innerText = 'TÀI KHOẢN';
        rightSlot.onclick = () => openUserProfile();
        rightSlot.querySelector('svg').innerHTML = '<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>';
      } else {
        // KHÁCH: TẢI APP & CẨM NANG
        centerText.innerText = 'TẢI APP';
        centerSlot.onclick = () => showToast('Đang tải ứng dụng...');
        centerSlot.querySelector('svg').innerHTML = '<path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/>';

        rightText.innerText = 'CẨM NANG';
        rightSlot.onclick = () => window.open('https://www.giaitriqq88.com', '_blank');
        rightSlot.querySelector('svg').innerHTML = '<path d="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z"/>';
      }
    }

    window.onload = () => {
      renderViewport();
      checkSession();
    };
  </script>
</body>
</html>
