    /* ĐĂNG NHẬP & TỰ ĐỘNG CỨU HỘ LOCALSTORAGE KHI SERVER MẤT DỮ LIỆU */
    async function handleAuthSubmit(e) {
      e.preventDefault();
      const username = document.getElementById('input-username').value.trim();
      const password = document.getElementById('input-password').value.trim();
      const isLogin = document.getElementById('btn-modal-action').innerText === 'ĐĂNG NHẬP';
      const endpoint = isLogin ? '/api/login' : '/api/register';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        const data = await res.json();

        if (data.success) {
          showToast(data.message);
          localStorage.setItem('qq88_saved_account', JSON.stringify(data.user));
          closeAuthModal();
          checkSession();
        } else {
          const backup = localStorage.getItem('qq88_saved_account');
          if (backup) {
            try {
              const savedUser = JSON.parse(backup);
              if (savedUser.username === username && savedUser.password === password) {
                showToast('Đang khôi phục tài khoản từ bộ nhớ thiết bị...');
                const syncRes = await fetch('/api/sync-backup', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ user: savedUser })
                });
                const syncData = await syncRes.json();
                if (syncData.success) {
                  showToast('Khôi phục tài khoản thành công!');
                  closeAuthModal();
                  checkSession();
                  return;
                }
              }
            } catch (err) {}
          }
          showToast(data.message);
        }
      } catch (err) {
        showToast('Lỗi kết nối tới máy chủ!');
      }
    }

    /* ĐỒNG BỘ SESSION & CẬP NHẬT GIAO DIỆN CHUẨN XÁC */
    async function checkSession() {
      try {
        let res = await fetch('/api/me');
        let data = await res.json();

        if (!data.loggedIn) {
          const backup = localStorage.getItem('qq88_saved_account');
          if (backup) {
            try {
              const savedUser = JSON.parse(backup);
              const syncRes = await fetch('/api/sync-backup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ user: savedUser })
              });
              const syncData = await syncRes.json();
              if (syncData.success) {
                data = { loggedIn: true, user: syncData.user };
              }
            } catch (err) {}
          }
        }

        const guestZone = document.getElementById('guest-zone');
        const userZone = document.getElementById('user-zone');
        const sidebarAuthText = document.getElementById('sidebar-auth-text');
        const admBtn = document.getElementById('admin-floating-btn');

        if (data.loggedIn && data.user) {
          if (guestZone) guestZone.style.display = 'none';
          if (userZone) userZone.style.display = 'block';
          document.getElementById('display-username').innerText = data.user.username;
          updateUserBalanceDisplay(data.user.balance || 0);

          localStorage.setItem('qq88_saved_account', JSON.stringify(data.user));

          if (sidebarAuthText) sidebarAuthText.innerText = 'ĐĂNG XUẤT';
		  applyDynamicBottomNav(true);
          if (admBtn) admBtn.style.display = (data.user.role === 'admin') ? 'block' : 'none';
        } else {
          if (guestZone) guestZone.style.display = 'block';
          if (userZone) userZone.style.display = 'none';
          if (sidebarAuthText) sidebarAuthText.innerText = 'ĐĂNG NHẬP';
		  applyDynamicBottomNav(false);
          if (admBtn) admBtn.style.display = 'none';
        }
      } catch (e) {
        console.error(e);
      }
    }

