    .deposit-sec-title .dot-orange { width: 7px; height: 7px; background: #ea580c; border-radius: 50%; display: inline-block; }
    .deposit-sec-title .dot-teal { width: 7px; height: 7px; background: #0d9488; border-radius: 50%; display: inline-block; }
    .methods-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .method-item {
      background: #ffffff;
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      cursor: pointer;
      border: 1.5px solid transparent;
      box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }
    .method-item.active { border: 2px solid #e11d48 !important; }
    .channels-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .channel-item {
      background: #ffffff;
      border: 1.2px solid #e2e8f0;
