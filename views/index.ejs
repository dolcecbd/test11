    .acc-btn-reload svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: #44321c;
      stroke-width: 2.2;
    }
    /* 3 NÚT NẠP TIỀN - RÚT TIỀN - THẺ CỦA TÔI NỔI 3D ÁNH KIM */
    .acc-btn-actions {
      display: flex;
      gap: 10px;
      margin-top: 14px;
      position: relative;
      z-index: 3;
    }
    .acc-action-pill {
      flex: 1;
      padding: 9px 0;
      background: linear-gradient(180deg, #fffcf5 0%, #fbe8c8 100%);
      border: 1.2px solid #ebc68d;
      border-radius: 20px;
      text-align: center;
      font-size: 13px;
      font-weight: 800;
      color: #361f06;
      cursor: pointer;
      box-shadow: 0 2px 4px rgba(180, 120, 30, 0.15);
      transition: transform 0.1s ease;
