        const t = document.getElementById('qqToast');
        t.textContent = msg;
        t.style.display = 'block';
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
            t.style.display = 'none';
        }, 2400);
    }

    // Tự động cập nhật toàn bộ giao diện theo trạng thái đăng nhập
    function applyAuthStateUI() {
        const guestAuthCol = document.getElementById('guestAuthCol');
        const loggedInfoCol = document.getElementById('loggedInfoCol');
        const guestQuickIcons = document.getElementById('guestQuickIcons');
        const loggedQuickIcons = document.getElementById('loggedQuickIcons');

        const navMidIconWrap = document.getElementById('navMidIconWrap');
        const navMidText = document.getElementById('navMidText');
        const navRightIconWrap = document.getElementById('navRightIconWrap');
        const navRightText = document.getElementById('navRightText');

        if (currentUser && currentUser.username) {
            guestAuthCol.style.display = 'none';
            loggedInfoCol.style.display = 'flex';
            guestQuickIcons.style.display = 'none';
            loggedQuickIcons.style.display = 'flex';

            const balStr = Number(currentUser.balance || 0).toFixed(2) + 'K';
            document.getElementById('lobbyUsername').textContent = currentUser.username;
            document.getElementById('lobbyBalance').textContent = balStr;
            document.getElementById('lobbyVipText').textContent = 'VIP' + (currentUser.vipLevel || 0);

            document.getElementById('accUsername').textContent = currentUser.username;
            document.getElementById('accBigBalance').textContent = balStr;
            document.getElementById('accVipBadge').textContent = 'VIP' + (currentUser.vipLevel || 0);
            document.getElementById('accJoinDate').textContent = 'Đã tham gia: ' + (currentUser.joinDate || '2026-09-30');

            // Đổi Bottom Nav sang: HOÀN TRẢ & TÀI KHOẢN
            navMidIconWrap.innerHTML = `<img src="/images/nav_hoantra.png" alt="Hoàn Trả" onerror="this.outerHTML='🪙'">`;
            navMidText.textContent = 'HOÀN TRẢ';
            navRightIconWrap.innerHTML = `<img src="/images/nav_taikhoan.png" alt="Tài Khoản" onerror="this.outerHTML='👤'">`;
            navRightText.textContent = 'TÀI KHOẢN';
        } else {
            guestAuthCol.style.display = 'flex';
            loggedInfoCol.style.display = 'none';
            guestQuickIcons.style.display = 'flex';
            loggedQuickIcons.style.display = 'none';

            // Đổi Bottom Nav sang: TẢI APP & CẨM NANG
            navMidIconWrap.innerHTML = `<img src="/images/nav_taiapp.png" alt="Tải App" onerror="this.outerHTML='⬇️'">`;
            navMidText.textContent = 'TẢI APP';
            navRightIconWrap.innerHTML = `<img src="/images/nav_camnang.png" alt="Cẩm Nang" onerror="this.outerHTML='📖'">`;
            navRightText.textContent = 'CẨM NANG';
        }
    }

    // Đồng bộ dữ liệu user từ server
    async function refreshUserData(showNotice) {
        if (!currentUser || !currentUser.username) return;
        try {
            const res = await fetch(`/api/user/${encodeURIComponent(currentUser.username)}`);
            const data = await res.json();
            if (data.success && data.user) {
                currentUser = data.user;
                localStorage.setItem('qq88_user', JSON.stringify(currentUser));
                applyAuthStateUI();
                updateWithdrawStageUI();
                if (showNotice) showToast('Đã đồng bộ số dư mới nhất!');
            }
        } catch (err) {
            if (showNotice) showToast('Đã làm mới số dư ví chính');
        }
    }

    // Xử lý nút giữa & nút phải trên thanh Bottom Nav
    function handleNavMidClick() {
        if (currentUser && currentUser.username) {
            openRefundOverlay();
        } else {
            window.open('/loading-gateway', '_blank');
        }
    }

    function handleNavRightClick() {
        if (currentUser && currentUser.username) {
            openAccountOverlay();
        } else {
            window.open('https://www.giaitriqq88.com', '_blank');
        }
    }

    function handleCSKHClick() {
        if (CSKH_URL && CSKH_URL.trim() !== '') {
            window.open(CSKH_URL, '_blank');
        } else {
            showToast('Đang kết nối cổng CSKH trực tuyến 24/7...');
        }
    }

    function handleDepositClick() {
        if (!currentUser) return openAuthOverlay('login');
        if (typeof window.openDepositModal === 'function') {
            window.openDepositModal();
        } else {
            showToast('Đang mở cổng nạp tiền SunPay / ACB QR...');
        }
    }

    function launchGame(gameName) {
        if (!currentUser) {
            showToast('Vui lòng đăng nhập để tham gia trò chơi!');
            openAuthOverlay('login');
            return;
        }
        showToast(`Đang vào sảnh: ${gameName}...`);
    }

    function copyUsername() {
        if (!currentUser) return;
        navigator.clipboard?.writeText(currentUser.username);
        showToast('Đã sao chép tên tài khoản: ' + currentUser.username);
    }

    // ====================================================
    // ĐIỀU KHIỂN ĐÓNG / MỞ CÁC MÀN HÌNH TRÀN NỘI BỘ
    // ====================================================
    function closeAllOverlays() {
        document.querySelectorAll('.internal-page-overlay').forEach(el => el.classList.remove('show'));
    }

    function openPromoModal(defaultCat) {
        closeAllOverlays();
        document.getElementById('promoOverlay').classList.add('show');
        renderPromoCategory(defaultCat || 'SCATTER NỔ HŨ');
    }

    function renderPromoCategory(catName) {
        document.querySelectorAll('.promo-tag-btn').forEach(btn => {
            btn.classList.toggle('active', btn.getAttribute('data-cat') === catName);
        });

        const listEl = document.getElementById('promoBannerList');
        const items = PROMO_DATA[catName] || PROMO_DATA['HOT'];
        listEl.innerHTML = items.map(item => `
            <div class="promo-card-item" onclick="showToast('Đang xem chi tiết khuyến mãi: ${item.tag}')">
                <img src="/images/${item.img}" alt="${item.title}" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <div class="promo-fallback-box" style="display:none;">
                    <div class="promo-fallback-tag">${item.tag}</div>
                    <div class="promo-fallback-title">${item.title}</div>
                    <div class="promo-fallback-sub">${item.sub}</div>
                </div>
            </div>
        `).join('');
    }

    function openRefundOverlay() {
        if (!currentUser) return openAuthOverlay('login');
        closeAllOverlays();
        document.getElementById('refundOverlay').classList.add('show');
        switchRefundTab('mine');
    }

    function switchRefundTab(tab) {
        const isMine = tab === 'mine';
        document.getElementById('tabRefundMine').classList.toggle('active', isMine);
        document.getElementById('tabRefundHist').classList.toggle('active', !isMine);
        document.getElementById('refundMineContent').style.display = isMine ? 'flex' : 'none';
        document.getElementById('refundHistContent').style.display = isMine ? 'none' : 'flex';
    }

    function openAccountOverlay() {
        if (!currentUser) return openAuthOverlay('login');
        closeAllOverlays();
        refreshUserData(false);
        document.getElementById('accountOverlay').classList.add('show');
    }

    // ====================================================
    // ĐĂNG NHẬP / ĐĂNG KÝ JOHN TERRY
    // ====================================================
    function openAuthOverlay(mode) {
        document.getElementById('authOverlay').classList.add('show');
        switchAuthTab(mode || 'login');
    }

    function closeAuthOverlay() {
        document.getElementById('authOverlay').classList.remove('show');
    }

    function switchAuthTab(mode) {
        const isLogin = mode === 'login';
        document.getElementById('tabBtnLogin').classList.toggle('active', isLogin);
        document.getElementById('tabBtnRegister').classList.toggle('active', !isLogin);
        document.getElementById('loginForm').style.display = isLogin ? 'block' : 'none';
        document.getElementById('registerForm').style.display = isLogin ? 'none' : 'block';
    }

    async function submitLogin(e) {
        e.preventDefault();
        const username = document.getElementById('loginUsername').value.trim();
        const password = document.getElementById('loginPassword').value.trim();
        try {
            const res = await fetch('/api/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });
            const data = await res.json();
            if (!data.success) return showToast(data.message || 'Đăng nhập thất bại!');
            currentUser = data.user;
            localStorage.setItem('qq88_user', JSON.stringify(currentUser));
            applyAuthStateUI();
            closeAuthOverlay();
            showToast('Chào mừng hội viên ' + currentUser.username + '!');
        } catch (err) {
            showToast('Lỗi kết nối máy chủ!');
        }
    }

    async function submitRegister(e) {
        e.preventDefault();
        const username = document.getElementById('regUsername').value.trim();
        const password = document.getElementById('regPassword').value.trim();
        const fullName = document.getElementById('regFullName').value.trim();
        const phone = document.getElementById('regPhone').value.trim();

        try {
            const res = await fetch('/api/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password, fullName, phone })
            });
            const data = await res.json();
            if (!data.success) return showToast(data.message || 'Đăng ký thất bại!');
            currentUser = data.user;
            localStorage.setItem('qq88_user', JSON.stringify(currentUser));
            applyAuthStateUI();
            closeAuthOverlay();
            showToast('Đăng ký tài khoản thành công!');
        } catch (err) {
            showToast('Lỗi kết nối máy chủ!');
        }
    }

    function logoutUser() {
        currentUser = null;
        localStorage.removeItem('qq88_user');
        closeAllOverlays();
        applyAuthStateUI();
        showToast('Đã đăng xuất tài khoản thành công!');
    }

    // ====================================================
    // RÚT TIỀN & THÊM NGÂN HÀNG KHÓA VĨNH VIỄN
    // ====================================================
    function openWithdrawOverlay() {
        if (!currentUser) return openAuthOverlay('login');
        closeAllOverlays();
        document.getElementById('withdrawOverlay').classList.add('show');
        switchWithdrawMethod('bank');
        updateWithdrawStageUI();
    }

    function switchWithdrawMethod(method) {
        currentWithdrawMethod = method;
        document.getElementById('wdTabBank').classList.toggle('active', method === 'bank');
        document.getElementById('wdTabCrypto').classList.toggle('active', method === 'crypto');
        document.getElementById('wdTabMomo').classList.toggle('active', method === 'momo');

        const amountInput = document.getElementById('wdAmountInput');
        const cryptoNotice = document.getElementById('cryptoRateNotice');

        if (method === 'crypto') {
            amountInput.placeholder = '500 ~ 1,000,000';
            cryptoNotice.style.display = 'block';
        } else {
            amountInput.placeholder = '100 ~ 300,000';
            cryptoNotice.style.display = 'none';
        }
        updateWithdrawStageUI();
    }

    function updateWithdrawStageUI() {
        if (!currentUser) return;
        const bal = Number(currentUser.balance || 0).toFixed(2);
        document.getElementById('wdMainWallet').textContent = bal;
        document.getElementById('wdAvailWallet').textContent = bal;

        const stageTitle = document.getElementById('wdStageTitle');
        const emptyVis = document.getElementById('wdEmptyVisual');
        const emptyImg = document.getElementById('wdEmptyImg');
        const emptyText = document.getElementById('wdEmptyText');
        const boundCard = document.getElementById('wdBoundCard');
        const redPlus = document.getElementById('wdRedPlusBtn');

        if (currentWithdrawMethod === 'bank') {
            if (currentUser.isBankLocked && currentUser.bankInfo && currentUser.bankInfo.accountNumber) {
                stageTitle.textContent = 'Thẻ ngân hàng của tôi(1/3)';
                emptyVis.style.display = 'none';
                boundCard.style.display = 'flex';
                redPlus.style.display = 'none'; // Khóa cứng vĩnh viễn không cho user tự sửa

                const accNum = currentUser.bankInfo.accountNumber;
                const maskedNum = accNum.length > 4 ? '**** **** ' + accNum.slice(-4) : accNum;
                document.getElementById('boundBankName').textContent = currentUser.bankInfo.bankName;
                document.getElementById('boundBankNumber').textContent = maskedNum;
                document.getElementById('boundBankHolder').textContent = 'CHỦ THẺ: ' + (currentUser.maskedName || 'N*****');
            } else {
                stageTitle.textContent = 'Thẻ ngân hàng của tôi(0/3)';
                emptyVis.style.display = 'flex';
                boundCard.style.display = 'none';
                redPlus.style.display = 'flex';
                if (emptyImg) emptyImg.src = '/images/card_empty_bank.png';
                emptyText.textContent = 'Thẻ ngân hàng trống';
            }
        } else if (currentWithdrawMethod === 'crypto') {
            stageTitle.textContent = 'Ví của tôi(0/2)';
            emptyVis.style.display = 'flex';
            boundCard.style.display = 'none';
            redPlus.style.display = 'flex';
            if (emptyImg) emptyImg.src = '/images/card_empty_crypto.png';
            emptyText.textContent = 'Danh sách ví trống';
        } else {
            stageTitle.textContent = 'Bị ràng buộc MOMO (0/1)';
            emptyVis.style.display = 'flex';
            boundCard.style.display = 'none';
            redPlus.style.display = 'flex';
            if (emptyImg) emptyImg.src = '/images/card_empty_momo.png';
            emptyText.textContent = 'Ví điện tử rỗng';
        }
    }

    function openBindBankOverlay() {
        if (!currentUser) return;
        if (currentUser.isBankLocked) {
            return showToast('Tài khoản ngân hàng đã được khóa bảo mật vĩnh viễn. Chỉ Admin mới có thể thay đổi!');
        }
        document.getElementById('bindMaskedHolder').value = currentUser.maskedName || 'D*****';
        document.getElementById('bindBankOverlay').classList.add('show');
    }

    function closeBindBankOverlay() {
        document.getElementById('bindBankOverlay').classList.remove('show');
    }

    async function submitBindBank() {
        const bankName = document.getElementById('bindBankName').value;
        const accountNumber = document.getElementById('bindAccountNumber').value.trim();
        const pass1 = document.getElementById('bindWithdrawPass1').value.trim();
        const pass2 = document.getElementById('bindWithdrawPass2').value.trim();

        if (!bankName) return showToast('Vui lòng chọn ngân hàng của bạn!');
        if (!accountNumber) return showToast('Vui lòng nhập số tài khoản ngân hàng!');
        if (!pass1 || pass1.length < 4) return showToast('Vui lòng đặt mật khẩu rút tiền (tối thiểu 4 ký tự)!');
        if (pass1 !== pass2) return showToast('Mật khẩu rút tiền nhập lại không khớp!');

        try {
            const res = await fetch('/api/user/bind-bank', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    username: currentUser.username,
                    bankName,
                    accountNumber,
                    withdrawPassword: pass1
                })
            });
            const data = await res.json();
            if (!data.success) return showToast(data.message);

            currentUser = data.user;
            localStorage.setItem('qq88_user', JSON.stringify(currentUser));
            closeBindBankOverlay();
            updateWithdrawStageUI();
            showToast('Đã lưu và khóa bảo mật tài khoản ngân hàng vĩnh viễn!');
        } catch (err) {
            showToast('Lỗi kết nối khi lưu ngân hàng!');
        }
    }

    function checkWithdrawReady() {
        const amt = Number(document.getElementById('wdAmountInput').value);
        const pass = document.getElementById('wdPassInput').value.trim();
        const btn = document.getElementById('wdSubmitBtn');
        btn.classList.toggle('ready', amt >= 100 && pass.length > 0);
    }

    async function submitWithdrawOrder() {
        if (!currentUser) return;
        if (!currentUser.isBankLocked) {
            return showToast('Vui lòng bấm dấu (+) đỏ để liên kết ngân hàng trước khi rút tiền!');
        }
        const amount = document.getElementById('wdAmountInput').value.trim();
        const withdrawPassword = document.getElementById('wdPassInput').value.trim();

        try {
            const res = await fetch('/api/user/withdraw', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    username: currentUser.username,
                    amount,
                    withdrawPassword,
                    method: currentWithdrawMethod
                })
            });
            const data = await res.json();
            if (!data.success) return showToast(data.message);

            currentUser = data.user;
            localStorage.setItem('qq88_user', JSON.stringify(currentUser));
            document.getElementById('wdAmountInput').value = '';
            document.getElementById('wdPassInput').value = '';
            checkWithdrawReady();
            applyAuthStateUI();
            updateWithdrawStageUI();
            showToast(data.message);
        } catch (err) {
            showToast('Lỗi kết nối khi gửi lệnh rút tiền!');
        }
    }

    function showWithdrawHistoryToast() {
        if (!currentUser || !currentUser.withdrawHistory || currentUser.withdrawHistory.length === 0) {
            return showToast('Chưa có lịch sử rút tiền');
        }
        const latest = currentUser.withdrawHistory[0];
        showToast(`Lệnh gần nhất: Rút ${latest.amount}K về ${latest.bankName} (${latest.status})`);
    }

    function toggleInputPassword(inputId) {
        const el = document.getElementById(inputId);
        el.type = el.type === 'password' ? 'text' : 'password';
    }
</script>
</body>
</html>
