    /* ĐỊNH TUYẾN SLUG CHUẨN XÁC ĐỂ KHÔNG BỊ TRÙNG TRANG SẢNH */
    function getGameSlug(gameName) {
      const n = (gameName || '').toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .replace(/[^a-z0-9]/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');

      if (n.includes('cao-boi') || n.includes('quyet-chien') || n.includes('slot')) return 'slot-caoboi';
      if (n.includes('danh-ca') || n.includes('ban-ca')) return 'banca-jackpot';
      if (n.includes('tai-xiu')) return 'gamebai-taixiu';
      return n || 'slot-caoboi';
    }

    /* MỞ CON GAME ĐỘC LẬP TRÊN IFRAME */
    function launchGame(gameName) {
      const slug = getGameSlug(gameName);
      const modal = document.getElementById('game-play-modal');
      const title = document.getElementById('playing-game-title');
      const iframe = document.getElementById('game-iframe');
      const loader = document.getElementById('game-loader');

      modal.style.display = 'flex';
      title.innerText = gameName;
      iframe.style.display = 'none';
      loader.style.display = 'block';
      document.body.style.overflow = 'hidden';

      setTimeout(() => {
        loader.style.display = 'none';
        iframe.style.display = 'block';
        iframe.src = '/game/' + slug;
      }, 400);
    }

