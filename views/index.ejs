      if (!imgSrc || imgSrc.includes('html')) return showToast('Chưa có ảnh mã QR!');
      const a = document.createElement('a');
      a.href = imgSrc;
      a.download = 'QR_ThanhToan_QQ88.png';
      a.target = '_blank';
      document.body.appendChild(a);
      a.click();
