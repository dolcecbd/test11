      const isLogged = document.getElementById('user-zone').style.display !== 'none';
      if (!isLogged) return openLoginView();
      closeAllViews();
      document.getElementById('wd-available-balance').innerText = document.getElementById('display-balance').innerText;
      renderWithdrawBankState();
      document.getElementById('withdraw-view').style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeWithdrawView() {
      document.getElementById('withdraw-view').style.display = 'none';
      document.body.style.overflow = '';
