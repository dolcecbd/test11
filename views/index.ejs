function syncProfileGoldCard(user) {
  if (!user) return;
  
  // 1. Tự đổi tên tài khoản trên thẻ vàng
  const nameEl = document.getElementById('acc-username-val');
  if (nameEl && user.username) nameEl.innerText = user.username;
  
  // 2. Tự đổi ngày tham gia chuẩn YYYY-MM-DD theo từng tài khoản
  const joinEl = document.getElementById('acc-join-val');
  if (joinEl) {
    const rawDate = user.created_at || user.createdAt;
    const dateStr = rawDate 
      ? (rawDate.includes('T') ? rawDate.split('T')[0] : rawDate) 
      : new Date().toLocaleDateString('en-CA');
    joinEl.innerText = 'Đã tham gia: ' + dateStr;
  }

  // 3. Tự cập nhật số dư
  const balEl = document.getElementById('acc-balance-val');
  if (balEl && user.balance !== undefined) {
    balEl.innerText = user.balance + 'K';
  }
}

