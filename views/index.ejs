    function closePaymentConfirm() {
      if(paymentTimerInterval) clearInterval(paymentTimerInterval);
      document.getElementById('payment-confirm-view').style.display = 'none';
      document.getElementById('deposit-view').style.display = 'flex';
    }

    function startPaymentTimer(durationInSeconds) {
      if(paymentTimerInterval) clearInterval(paymentTimerInterval);
      let timer = durationInSeconds;
      const display = document.getElementById('pc-timer-text');
      paymentTimerInterval = setInterval(function () {
        let minutes = parseInt(timer / 60, 10);
        let seconds = parseInt(timer % 60, 10);
        display.textContent = (minutes < 10 ? "0" + minutes : minutes) + ":" + (seconds < 10 ? "0" + seconds : seconds);
        if (--timer < 0) {
          clearInterval(paymentTimerInterval);
          closePaymentConfirm();
        }
      }, 1000);
    }

