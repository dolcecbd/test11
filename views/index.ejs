      </div>
      <div class="sidebar-menu-item" onclick="handleMenuClick('warp')">
        <div class="sidebar-item-icon"><img src="/images/ic_warp.png" alt="1.1.1.1"></div>
        <span class="sidebar-item-text">TẢI 1.1.1.1</span>
      </div>
      <div class="sidebar-menu-item" id="sidebar-auth-btn" onclick="handleSidebarAuth()">
        <div class="sidebar-item-icon"><img src="/images/ic_login.png" alt="Auth"></div>
