        <div class="cat-tab-item" data-cat="gamebai" onclick="switchCategory('gamebai', this)"><img src="/images/game bai.png" alt="Game bài"></div>
        <div class="cat-tab-item" data-cat="daga" onclick="switchCategory('daga', this)"><img src="/images/da ga.png" alt="Đá gà"></div>
        <div class="cat-tab-item" data-cat="xoso" onclick="switchCategory('xoso', this)"><img src="/images/xo so.png" alt="Xổ số"></div>
